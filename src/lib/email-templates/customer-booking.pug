doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="x-apple-disable-message-reformatting")
    title= subject
  body(style="margin:0;padding:0;background:#f3ede4;color:#78243f;font-family:Arial,Helvetica,sans-serif;")
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3ede4;padding:28px 12px;")
      tr
        td(align="center")
          table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px;background:#fcf9f5;border:1px solid #dec8cf;")
            tr
              td(style="height:7px;background:#9f174d;font-size:0;line-height:0;")
            tr
              td(style="padding:30px 34px 8px;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0")
                  tr
                    td(width="48" valign="middle")
                      table(role="presentation" width="42" height="42" cellspacing="0" cellpadding="0" border="0" style="background:#9f174d;")
                        tr
                          td(align="center" valign="middle" style="color:#fcf9f5;font-family:Georgia,serif;font-size:19px;letter-spacing:1px;") SB
                    td(valign="middle" style="padding-left:12px;")
                      p(style="margin:0;color:#78243f;font-size:11px;font-weight:bold;letter-spacing:1.7px;text-transform:uppercase;") Sbosh's Beauty Studio
                      p(style="margin:5px 0 0;color:#78243f;font-size:12px;") Bram Fischerville · Roodepoort
            tr
              td(style="padding:24px 34px 0;")
                p(style="margin:0 0 10px;color:#78243f;font-size:12px;font-weight:bold;letter-spacing:1.2px;text-transform:uppercase;")= eyebrow
                h1(style="margin:0;color:#78243f;font-family:Georgia,'Times New Roman',serif;font-size:32px;font-weight:normal;line-height:1.2;")= heading
                p(style="margin:14px 0 0;color:#78243f;font-size:15px;line-height:1.7;")= intro
            tr
              td(style="padding:25px 34px 0;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-top:1px solid #dec8cf;border-bottom:1px solid #dec8cf;")
                  tr
                    td(style="padding:15px 0 13px;color:#78243f;font-size:12px;") Booking reference
                    td(align="right" style="padding:15px 0 13px;color:#78243f;font-family:Georgia,serif;font-size:20px;")= reference
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Service
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;font-weight:bold;")= serviceName
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;")= timeCaption
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;font-weight:bold;")= timeLabel
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Total
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:16px;font-weight:bold;")= price
            tr
              td(style="padding:24px 34px 0;")
                p(style="margin:0;color:#78243f;font-size:13px;line-height:1.7;") Keep this email for your records. If you need to discuss your request, contact the studio directly.
                table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:18px;")
                  tr
                    td(style="padding-right:10px;")
                      a(href=phoneHref style="display:inline-block;padding:12px 16px;background:#9f174d;color:#f3ede4;text-decoration:none;font-size:13px;font-weight:bold;") Call the studio
                    td
                      a(href=mapHref style="display:inline-block;padding:11px 15px;border:1px solid #dec8cf;color:#78243f;text-decoration:none;font-size:13px;font-weight:bold;") Find us
                    td(style="padding-left:10px;")
                      a(href=emailHref style="display:inline-block;padding:11px 15px;border:1px solid #dec8cf;color:#78243f;text-decoration:none;font-size:13px;font-weight:bold;") Email us
            tr
              td(style="padding:24px 34px 30px;")
                p(style="margin:0;color:#78243f;font-size:12px;line-height:1.7;")= studioPhone
                p(style="margin:3px 0 0;color:#78243f;font-size:12px;line-height:1.7;")= studioEmail
                p(style="margin:3px 0 0;color:#78243f;font-size:12px;line-height:1.7;")= address
                p(style="margin:20px 0 0;padding-top:15px;border-top:1px solid #dec8cf;color:#78243f;font-size:11px;line-height:1.6;") This message was sent by Sbosh's Beauty Studio about your booking request.
  </body>
