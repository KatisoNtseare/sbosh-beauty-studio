doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= subject
  body(style="margin:0;padding:0;background:#f3ede4;color:#78243f;font-family:Arial,Helvetica,sans-serif;")
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3ede4;padding:28px 12px;")
      tr
        td(align="center")
          table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px;background:#fcf9f5;border:1px solid #dec8cf;")
            tr
              td(style="height:7px;background:#9f174d;font-size:0;line-height:0;")
            tr
              td(style="padding:30px 34px 8px;")
                p(style="margin:0;color:#78243f;font-size:11px;font-weight:bold;letter-spacing:1.7px;text-transform:uppercase;") Sbosh's Beauty Studio
                p(style="margin:5px 0 0;color:#78243f;font-size:12px;") Booking desk
            tr
              td(style="padding:24px 34px 0;")
                p(style="margin:0 0 10px;color:#78243f;font-size:12px;font-weight:bold;letter-spacing:1.2px;text-transform:uppercase;") New request
                h1(style="margin:0;color:#78243f;font-family:Georgia,'Times New Roman',serif;font-size:32px;font-weight:normal;line-height:1.2;")= heading
                p(style="margin:14px 0 0;color:#78243f;font-size:15px;line-height:1.7;")= intro
            tr
              td(style="padding:25px 34px 0;")
                table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-top:1px solid #dec8cf;border-bottom:1px solid #dec8cf;")
                  tr
                    td(style="padding:13px 0;color:#78243f;font-size:13px;") Reference
                    td(align="right" style="padding:13px 0;color:#78243f;font-family:Georgia,serif;font-size:19px;")= reference
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Customer
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;font-weight:bold;")= customerName
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Email
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;")= customerEmail
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Phone
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;")= customerPhone
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Service
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;font-weight:bold;")= serviceName
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Requested time
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:14px;")= timeLabel
                  tr
                    td(style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:13px;") Total
                    td(align="right" style="padding:13px 0;border-top:1px solid #dec8cf;color:#78243f;font-size:15px;font-weight:bold;")= price
            tr
              td(style="padding:18px 34px 0;")
                p(style="margin:0;color:#78243f;font-size:12px;font-weight:bold;") Customer notes
                p(style="margin:7px 0 0;color:#78243f;font-size:13px;line-height:1.7;white-space:pre-line;")= notes
            tr
              td(style="padding:24px 34px 30px;")
                a(href=adminUrl style="display:inline-block;padding:13px 18px;background:#9f174d;color:#f3ede4;text-decoration:none;font-size:13px;font-weight:bold;") Open booking in admin
                if whatsappUrl
                  p(style="margin:12px 0 0;")
                    a(href=whatsappUrl style="display:inline-block;padding:13px 18px;background:#246b46;color:#f3ede4;text-decoration:none;font-size:13px;font-weight:bold;") Text customer on WhatsApp
                p(style="margin:18px 0 0;color:#78243f;font-size:11px;line-height:1.6;") Sbosh's Beauty Studio · Bram Fischerville, Roodepoort
  </body>
