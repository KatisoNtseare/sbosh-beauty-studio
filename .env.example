# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUST_PROXY_HEADERS=false

# ==========================================
# MongoDB Atlas
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sbosh_beauty_studio?retryWrites=true&w=majority

# ==========================================
# Authentication
# Generate a strong random secret for production.
# ==========================================
AUTH_SECRET=replace_with_at_least_32_random_characters

# ==========================================
# Cloudinary - Image Storage
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Admin bootstrap credentials (run `npm run seed:admin` to store a password hash)
# ==========================================
ADMIN_NAME=Studio Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# ==========================================
# Application Timezone
# ==========================================
APP_TIMEZONE=Africa/Johannesburg

# Optional, dedicated database used only by `npm run test:integration`.
# Must be an empty replica-set database named sbosh_beauty_test. Never use MONGODB_URI here.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/sbosh_beauty_test?replicaSet=rs0
