# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUST_PROXY_HEADERS=false

# ==========================================
# MongoDB Atlas
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sbosh_beauty_studio?retryWrites=true&w=majority

# ==========================================
# Authentication
# Generate a strong random secret for production.
# ==========================================
AUTH_SECRET=replace_with_at_least_32_random_characters

# ==========================================
# Cloudinary - Image Storage
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Admin bootstrap credentials (run `npm run seed:admin` to store a password hash)
# ==========================================
ADMIN_NAME=Studio Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# ==========================================
# Application Timezone
# ==========================================
APP_TIMEZONE=Africa/Johannesburg

# Optional test-only connection used exclusively by `npm run test:db:init` and
# `npm run test:integration`. Must be local, replica-set enabled, and never Atlas.
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/sbosh_beauty_test?replicaSet=rs0


# ==========================================
# Zoho SMTP - Email Sending
# ==========================================
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=sender@example.com
ZOHO_SMTP_PASS=replace_with_zoho_app_specific_password
CONTACT_RECEIVER=studio@example.com
